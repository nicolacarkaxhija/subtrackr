# Normalize line endings to LF in the repo, checkout native on Windows
* text=auto eol=lf

# Scripts must stay LF
*.sh text eol=lf

# Windows-specific
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.keystore binary
*.p8 binary
*.p12 binary
